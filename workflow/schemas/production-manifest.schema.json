{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Production Manifest",
  "type": "object",
  "required": ["status", "outputs", "sections"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["text_package", "media_generated", "video_generated"]
    },
    "notes": { "type": "array", "items": { "type": "string" } },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "type"],
        "properties": {
          "path": { "type": "string" },
          "type": { "type": "string" }
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "imagePath", "audioPath"],
        "properties": {
          "id": { "type": "string" },
          "imagePath": { "type": "string" },
          "audioPath": { "type": "string" }
        }
      }
    }
  }
}

